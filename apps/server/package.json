{
  "name": "@hubarr/server",
  "version": "1.1.0",
  "private": true,
  "description": "API Fastify de Hubarr ; sert aussi le front buildé.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/main.ts db:migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "10.1.12",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "proxy-addr": "^2.0.8",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hubarr/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/proxy-addr": "^2.0.3",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
