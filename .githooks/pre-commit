#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Hook pre-commit : `make check-fast` (lint, types)
# avant chaque commit ; les tests complets (`make check`) tournent à la
# demande, et la CI les relance après chaque push. Installé par `make hooks`.
# Ne pas le contourner (`--no-verify`).
set -eu

echo 'pre-commit : make check-fast'
exec make --no-print-directory check-fast
